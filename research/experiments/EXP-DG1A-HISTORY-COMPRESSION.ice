{"schema":"ckb-plane.research-experiment.v1","experiment_id":"EXP-DG1A-HISTORY-COMPRESSION-001","candidate_id":"CAND-DG1A-HISTORY-COMPRESSION","harness_id":"yggdrasil-isolated","controls":["naive genome development for each task variant","hypernetwork baseline with explicit task embeddings","fixed architecture baseline with full retraining","shuffled task order control"],"fixed_parameters":{"development_step_budget":"5000","genome_initialization":"xavier_uniform","memory_budget_mb":"512","mutation_rate":"0.01","population_budget":"1000","selection_pressure":"0.7","task_families":"3","tasks_per_family":"4"},"metrics":[{"name":"genome_size_reduction_ratio","comparator":"<=","threshold":0.85},{"name":"development_steps_reduction_ratio","comparator":"<=","threshold":0.85},{"name":"active_params_reduction_ratio","comparator":"<=","threshold":0.9},{"name":"lineage_reuse_events_per_task","comparator":">=","threshold":2},{"name":"retained_capability_after_sequence","comparator":">=","threshold":0.8}],"seeds":[42,123,456,789,1024],"compute_seconds":1200,"stop_conditions":["development_step_budget_exceeded","population_budget_exceeded","memory_budget_exceeded","convergence_plateau_100_steps","target_capability_reached"]}